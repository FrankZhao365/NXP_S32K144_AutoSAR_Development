                                  <VALUE>ComM_StateType CN_CAN00_5e566ad9 = COMM_NO_COM_NO_PENDING_REQUEST;&#13;
&#13;
(void)ComM_GetState(ComMConf_ComMChannel_CN_CAN00_5e566ad9, &amp;CN_CAN00_5e566ad9); /* SBSW_BSWM_FCTCALL_LOCALVAR */&#13;
